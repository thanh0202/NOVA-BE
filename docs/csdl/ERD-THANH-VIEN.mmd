erDiagram
    direction LR
    membershipAccounts["membership_accounts"] {
        bigint user_id PK, FK "NOT NULL"
        bigint tier_id FK "NOT NULL"
        datetime joined_at "NOT NULL"
        datetime tier_evaluated_at "NULL"
    }
    membershipBenefits["membership_benefits"] {
        bigint id PK "NOT NULL"
        string code UK "NOT NULL"
        string name "NOT NULL"
        string description "NOT NULL"
    }
    membershipPolicies["membership_policies"] {
        bigint id PK "NOT NULL"
        string code UK "NOT NULL"
        string name "NOT NULL"
        bigint vnd_per_point "NOT NULL"
        integer tier_window_months "NOT NULL"
        integer points_expiry_months "NOT NULL"
        datetime effective_from "NOT NULL"
        datetime effective_to "NULL"
    }
    membershipTierHistory["membership_tier_history"] {
        bigint id PK "NOT NULL"
        bigint user_id FK "NOT NULL"
        bigint from_tier_id FK "NULL"
        bigint to_tier_id FK "NOT NULL"
        bigint qualifying_spend_vnd "NOT NULL"
        string reason "NOT NULL"
        datetime evaluated_at "NOT NULL"
    }
    membershipTiers["membership_tiers"] {
        bigint id PK "NOT NULL"
        string code UK "NOT NULL"
        string name "NOT NULL"
        integer rank UK "NOT NULL"
        bigint minimum_spend_vnd "NOT NULL"
        integer discount_bps "NOT NULL"
        integer points_multiplier_bps "NOT NULL"
        bool is_active "NOT NULL"
    }
    orders["orders"] {
        bigint id PK "NOT NULL"
        string order_number UK "NOT NULL"
        bigint user_id FK "NOT NULL"
        string idempotency_key "NOT NULL"
        bigint warehouse_id FK "NOT NULL"
        bigint payment_method_id FK "NOT NULL"
        string status "NOT NULL"
        string payment_status "NOT NULL"
        bool requires_payment_review "NOT NULL"
        bigint subtotal_vnd "NOT NULL"
        bigint discount_vnd "NOT NULL"
        bigint shipping_fee_vnd "NOT NULL"
        bigint total_vnd "NOT NULL"
        integer points_earned "NOT NULL"
        bigint membership_policy_id FK "NULL"
        integer points_multiplier_bps "NOT NULL"
        datetime expires_at "NULL"
        datetime placed_at "NOT NULL"
        datetime paid_at "NULL"
        datetime delivered_at "NULL"
        datetime cancelled_at "NULL"
        string cancel_reason "NULL"
        datetime hidden_at "NULL"
        string note "NULL"
        bool is_demo "NOT NULL"
        string request_fingerprint "NULL"
    }
    pointsLedger["points_ledger"] {
        bigint id PK "NOT NULL"
        bigint user_id FK "NOT NULL"
        bigint order_id FK "NULL"
        bigint refund_id FK "NULL"
        integer points_delta "NOT NULL"
        string reason "NOT NULL"
        string idempotency_key UK "NOT NULL"
        datetime expires_at "NULL"
        datetime created_at "NOT NULL"
        string note "NULL"
    }
    refunds["refunds"] {
        bigint id PK "NOT NULL"
        bigint order_id FK "NOT NULL"
        bigint payment_attempt_id FK "NOT NULL"
        string idempotency_key UK "NOT NULL"
        bigint amount_vnd "NOT NULL"
        string status "NOT NULL"
        string reason "NOT NULL"
        string provider_refund_id "NULL"
        bigint requested_by FK "NULL"
        datetime requested_at "NOT NULL"
        datetime completed_at "NULL"
        bigint return_request_id FK "NULL"
    }
    tierBenefits["tier_benefits"] {
        bigint tier_id PK, FK "NOT NULL"
        bigint benefit_id PK, FK "NOT NULL"
        string detail "NULL"
    }
    users["users"] {
        bigint id PK "NOT NULL"
        string email "NOT NULL"
        string password_hash "NOT NULL"
        string full_name "NOT NULL"
        string phone "NULL"
        string avatar_url "NULL"
        string gender "NULL"
        string status "NOT NULL"
        datetime email_verified_at "NULL"
        datetime password_changed_at "NULL"
        datetime created_at "NOT NULL"
        datetime updated_at "NOT NULL"
        date birth_date "NULL"
    }
    membershipTiers ||..o{ membershipAccounts : "tier_id"
    users ||--o| membershipAccounts : "user_id"
    membershipTiers o|..o{ membershipTierHistory : "from_tier_id"
    membershipTiers ||..o{ membershipTierHistory : "to_tier_id"
    membershipAccounts ||..o{ membershipTierHistory : "user_id"
    orders o|..o{ pointsLedger : "order_id"
    orders o|..o{ pointsLedger : "order_id,user_id"
    refunds o|..o{ pointsLedger : "refund_id"
    refunds o|..o{ pointsLedger : "refund_id,order_id"
    membershipAccounts ||..o{ pointsLedger : "user_id"
    membershipBenefits ||--o{ tierBenefits : "benefit_id"
    membershipTiers ||--o{ tierBenefits : "tier_id"
