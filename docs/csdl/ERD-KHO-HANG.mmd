erDiagram
    direction LR
    inventoryBalances["inventory_balances"] {
        bigint warehouse_id PK, FK "NOT NULL"
        bigint variant_id PK, FK "NOT NULL"
        integer on_hand "NOT NULL"
        integer reserved "NOT NULL"
        datetime updated_at "NOT NULL"
    }
    inventoryMovements["inventory_movements"] {
        bigint id PK "NOT NULL"
        bigint warehouse_id FK "NOT NULL"
        bigint variant_id FK "NOT NULL"
        integer quantity_delta "NOT NULL"
        string reason "NOT NULL"
        bigint receipt_item_id FK "NULL"
        bigint order_item_id FK "NULL"
        string idempotency_key UK "NOT NULL"
        bigint created_by FK "NULL"
        datetime created_at "NOT NULL"
        string note "NULL"
    }
    inventoryReservations["inventory_reservations"] {
        bigint id PK "NOT NULL"
        bigint order_item_id FK, UK "NOT NULL"
        bigint variant_id FK "NOT NULL"
        bigint warehouse_id FK "NOT NULL"
        integer quantity "NOT NULL"
        string status "NOT NULL"
        datetime expires_at "NULL"
        datetime created_at "NOT NULL"
    }
    orderItems["order_items"] {
        bigint id PK "NOT NULL"
        bigint order_id FK "NOT NULL"
        bigint variant_id FK "NOT NULL"
        bigint product_id FK "NOT NULL"
        string sku_snapshot "NOT NULL"
        string product_name_snapshot "NOT NULL"
        string variant_snapshot "NOT NULL"
        string image_url_snapshot "NULL"
        integer quantity "NOT NULL"
        bigint unit_price_vnd "NOT NULL"
        bigint line_total_vnd "NULL"
        bigint flash_slot_item_id FK "NULL"
    }
    productVariants["product_variants"] {
        bigint id PK "NOT NULL"
        bigint product_id FK "NOT NULL"
        string sku UK "NOT NULL"
        string color "NOT NULL"
        integer storage_gb "NULL"
        integer ram_gb "NULL"
        bigint price_vnd "NOT NULL"
        bigint list_price_vnd "NULL"
        string price_kind "NOT NULL"
        string status "NOT NULL"
        datetime created_at "NOT NULL"
        datetime updated_at "NOT NULL"
    }
    stockReceiptItems["stock_receipt_items"] {
        bigint id PK "NOT NULL"
        bigint receipt_id FK "NOT NULL"
        bigint variant_id FK "NOT NULL"
        integer quantity "NOT NULL"
        bigint unit_cost_vnd "NOT NULL"
    }
    stockReceipts["stock_receipts"] {
        bigint id PK "NOT NULL"
        string code UK "NOT NULL"
        bigint warehouse_id FK "NOT NULL"
        bigint supplier_id FK "NULL"
        bigint received_by FK "NULL"
        string status "NOT NULL"
        datetime received_at "NOT NULL"
        string note "NULL"
        bool is_demo "NOT NULL"
    }
    suppliers["suppliers"] {
        bigint id PK "NOT NULL"
        string code UK "NOT NULL"
        string name "NOT NULL"
        string email "NULL"
        string phone "NULL"
        string address_line "NULL"
        bool is_demo "NOT NULL"
    }
    users["users"] {
        bigint id PK "NOT NULL"
        string email "NOT NULL"
        string password_hash "NOT NULL"
        string full_name "NOT NULL"
        string phone "NULL"
        string avatar_url "NULL"
        string gender "NULL"
        string status "NOT NULL"
        datetime email_verified_at "NULL"
        datetime password_changed_at "NULL"
        datetime created_at "NOT NULL"
        datetime updated_at "NOT NULL"
        date birth_date "NULL"
    }
    warehouses["warehouses"] {
        bigint id PK "NOT NULL"
        string code UK "NOT NULL"
        string name "NOT NULL"
        string address_line "NULL"
        bool is_active "NOT NULL"
    }
    productVariants ||--o{ inventoryBalances : "variant_id"
    warehouses ||--o{ inventoryBalances : "warehouse_id"
    orderItems o|..o{ inventoryMovements : "order_item_id"
    users o|..o{ inventoryMovements : "created_by"
    stockReceiptItems o|..o{ inventoryMovements : "receipt_item_id"
    productVariants ||..o{ inventoryMovements : "variant_id"
    warehouses ||..o{ inventoryMovements : "warehouse_id"
    orderItems ||..o| inventoryReservations : "order_item_id,variant_id"
    warehouses ||..o{ inventoryReservations : "warehouse_id"
    inventoryBalances ||..o{ inventoryReservations : "warehouse_id,variant_id"
    stockReceipts ||..o{ stockReceiptItems : "receipt_id"
    productVariants ||..o{ stockReceiptItems : "variant_id"
    users o|..o{ stockReceipts : "received_by"
    suppliers o|..o{ stockReceipts : "supplier_id"
