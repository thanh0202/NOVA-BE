erDiagram
    direction LR
    auditLogs["audit_logs"] {
        bigint id PK "NOT NULL"
        bigint actor_user_id FK "NULL"
        string action "NOT NULL"
        string entity_type "NOT NULL"
        string entity_id "NULL"
        jsonb before_data "NULL"
        jsonb after_data "NULL"
        inet ip_address "NULL"
        datetime created_at "NOT NULL"
    }
    deviceTokens["device_tokens"] {
        bigint id PK "NOT NULL"
        bigint user_id FK "NOT NULL"
        string token UK "NOT NULL"
        string platform "NOT NULL"
        bool is_active "NOT NULL"
        datetime updated_at "NOT NULL"
    }
    notificationPreferences["notification_preferences"] {
        bigint user_id PK, FK "NOT NULL"
        bool order_updates "NOT NULL"
        bool flash_sale_reminders "NOT NULL"
        bool marketing "NOT NULL"
        datetime updated_at "NOT NULL"
    }
    notifications["notifications"] {
        bigint id PK "NOT NULL"
        bigint user_id FK "NOT NULL"
        string type "NOT NULL"
        string title "NOT NULL"
        string body "NOT NULL"
        jsonb data "NOT NULL"
        datetime read_at "NULL"
        datetime created_at "NOT NULL"
        string dedup_key UK "NULL"
    }
    orders["orders"] {
        bigint id PK "NOT NULL"
        string order_number UK "NOT NULL"
        bigint user_id FK "NOT NULL"
        string idempotency_key "NOT NULL"
        bigint warehouse_id FK "NOT NULL"
        bigint payment_method_id FK "NOT NULL"
        string status "NOT NULL"
        string payment_status "NOT NULL"
        bool requires_payment_review "NOT NULL"
        bigint subtotal_vnd "NOT NULL"
        bigint discount_vnd "NOT NULL"
        bigint shipping_fee_vnd "NOT NULL"
        bigint total_vnd "NOT NULL"
        integer points_earned "NOT NULL"
        bigint membership_policy_id FK "NULL"
        integer points_multiplier_bps "NOT NULL"
        datetime expires_at "NULL"
        datetime placed_at "NOT NULL"
        datetime paid_at "NULL"
        datetime delivered_at "NULL"
        datetime cancelled_at "NULL"
        string cancel_reason "NULL"
        datetime hidden_at "NULL"
        string note "NULL"
        bool is_demo "NOT NULL"
        string request_fingerprint "NULL"
    }
    outboxEvents["outbox_events"] {
        bigint id PK "NOT NULL"
        string event_type "NOT NULL"
        string aggregate_id "NOT NULL"
        jsonb payload "NOT NULL"
        string dedup_key UK "NOT NULL"
        datetime available_at "NOT NULL"
        datetime processed_at "NULL"
        integer attempts "NOT NULL"
        string last_error "NULL"
        datetime created_at "NOT NULL"
    }
    searchHistory["search_history"] {
        bigint id PK "NOT NULL"
        bigint user_id FK "NOT NULL"
        string keyword "NOT NULL"
        datetime searched_at "NOT NULL"
    }
    storeSettings["store_settings"] {
        integer id PK "NOT NULL"
        jsonb data "NOT NULL"
        datetime updated_at "NOT NULL"
    }
    supportMessages["support_messages"] {
        bigint id PK "NOT NULL"
        bigint ticket_id FK "NOT NULL"
        bigint sender_user_id FK "NOT NULL"
        string body "NOT NULL"
        jsonb attachment_urls "NOT NULL"
        datetime created_at "NOT NULL"
    }
    supportTickets["support_tickets"] {
        bigint id PK "NOT NULL"
        string code UK "NOT NULL"
        bigint user_id FK "NOT NULL"
        bigint order_id FK "NULL"
        string subject "NOT NULL"
        string category "NOT NULL"
        string status "NOT NULL"
        bigint assigned_admin_id FK "NULL"
        datetime created_at "NOT NULL"
        datetime updated_at "NOT NULL"
        datetime closed_at "NULL"
    }
    users["users"] {
        bigint id PK "NOT NULL"
        string email "NOT NULL"
        string password_hash "NOT NULL"
        string full_name "NOT NULL"
        string phone "NULL"
        string avatar_url "NULL"
        string gender "NULL"
        string status "NOT NULL"
        datetime email_verified_at "NULL"
        datetime password_changed_at "NULL"
        datetime created_at "NOT NULL"
        datetime updated_at "NOT NULL"
        date birth_date "NULL"
    }
    users o|..o{ auditLogs : "actor_user_id"
    users ||..o{ deviceTokens : "user_id"
    users ||--o| notificationPreferences : "user_id"
    users ||..o{ notifications : "user_id"
    users ||..o{ searchHistory : "user_id"
    users ||..o{ supportMessages : "sender_user_id"
    supportTickets ||..o{ supportMessages : "ticket_id"
    users o|..o{ supportTickets : "assigned_admin_id"
    orders o|..o{ supportTickets : "order_id,user_id"
    users ||..o{ supportTickets : "user_id"
